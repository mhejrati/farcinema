---
import { Image } from 'astro:assets';
import { posterFor } from '../lib/images';
import { formatDate, pad, type Film } from '../lib/site';

interface Props {
  film: Film;
  eager?: boolean;
}
const { film, eager = false } = Astro.props;
const img = posterFor(film.poster);
---
<a class="film-card" href={`/films/${film.slug}/`}>
  <figure class="film-card__media">
    <Image
      src={img}
      alt={`Still from ${film.title}`}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      style={`object-position: ${film.focal ?? '50% 50%'}`}
      loading={eager ? 'eager' : 'lazy'}
    />
  </figure>
  <div class="film-card__body">
    <p class="film-card__meta">
      <span class="num">No. {pad(film.number)}</span>
      <span aria-hidden="true">·</span>
      <span>{formatDate(film.date, { month: 'short' })}</span>
    </p>
    <h3 class="film-card__title">{film.title}</h3>
    {film.title_fa && <p class="film-card__fa" lang="fa" dir="rtl">{film.title_fa}</p>}
    <p class="film-card__dir">{film.director} · {film.year}</p>
  </div>
</a>
